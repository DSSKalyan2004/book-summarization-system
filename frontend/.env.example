# Copy this file to .env and fill in your values
# For local development, use .env.development (overrides .env when running `npm run dev`)

# Backend API URL (base domain, WITHOUT /api suffix — code appends it automatically)
# Local:  leave empty (uses Vite proxy)
# Render: https://book-summarization-system.onrender.com
VITE_API_URL=https://book-summarization-system.onrender.com
