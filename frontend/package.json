{
  "name": "intelligent-book-summarization-platform",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others --names \"frontend,backend\" --prefix-colors \"cyan,green\" \"vite\" \"cd ../backend && set PYTHONIOENCODING=utf-8 && .venv\\\\Scripts\\\\uvicorn.exe main:app --host 0.0.0.0 --port 8000 --reload\"",
    "dev:frontend": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "serve:prod": "serve dist -l $PORT --single"
  },
  "dependencies": {
    "@google/genai": "^1.41.0",
    "@xenova/transformers": "^2.17.2",
    "framer-motion": "^12.34.3",
    "gsap": "^3.14.2",
    "lucide-react": "^0.563.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "serve": "^14.2.5"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.27",
    "concurrently": "^9.2.1",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
