# MongoDB Configuration (use MongoDB Atlas URI for Railway)
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/book-summarization?retryWrites=true&w=majority

# Server Configuration (Railway sets PORT automatically — do NOT hardcode)
# PORT=8000

# JWT Configuration
JWT_SECRET=your-very-secure-secret-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Node Environment
NODE_ENV=production

# Admin User (seeded on first startup)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme123
ADMIN_NAME=Admin

# Frontend URL for CORS (comma-separated for multiple origins)
# Example: https://your-frontend.up.railway.app,https://your-custom-domain.com
FRONTEND_URL=https://your-frontend.up.railway.app
